# Skopiuj ten plik jako .env i uzupelnij wlasnymi wartosciami.
# Plik .env jest w .gitignore i nigdy nie trafia do repozytorium.

# Adres aplikacji
BASE_URL=https://kislist.com

# Konto wlasciciela listy (administrator zespolu)
OWNER_EMAIL=
OWNER_PASSWORD=

# Konto zwyklego czlonka zespolu, powiazanego z ta sama lista.
# To on wedlug wymagania powinien dostac powiadomienie - i nie dostaje.
MEMBER_EMAIL=
MEMBER_PASSWORD=

# Publiczny link do udostepnionej listy (widok klienta).
# Generujesz go w aplikacji: ikona udostepniania -> checkbox "udostepnione"
# -> przycisk "Kopiuj link". Pelny adres, razem z tokenem.
SHARED_LIST_URL=

# Fragment nazwy produktu z listy, uzywany w scenariuszu.
# Musi byc unikalny w obrebie listy ORAZ widoczny bez przewijania -
# lista klienta uzywa wirtualnego przewijania (vue-recycle-scroller),
# wiec produkty spoza ekranu nie istnieja w DOM.
PRODUCT_A=Narożnik rozkładany Botse
